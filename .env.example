# Шаблон настроек. Скопируйте в .env рядом с orchestrator_v7.py и
# впишите реальные значения. Файл .env в .gitignore и в репозиторий не
# попадает. На Render эти же имена задаются в разделе Environment
# сервиса, а .env там не нужен.
#
# Переменные окружения, заданные вручную, имеют приоритет над .env.

# --- rieltorcollector: источник новых/подешевевших объявлений ---
# Адрес без пути, например https://rieltorcollector-xxxx.onrender.com
# Обязателен: без него оркестратору неоткуда брать объявления.
RIELTOR_COLLECTOR_URL=
RIELTOR_COLLECTOR_API_KEY=

# --- rieltor-cleaner: готовый baseline, обновляется раз в 12 часов ---
# Ключ обязателен при деплое: файла baseline нет в репозитории (28 МБ),
# и на чистом диске он берётся только отсюда. Пустой ключ выключает
# автообновление и требует локального baseline/krisha_astana_baseline.csv.
RIELTOR_CLEANER_API_KEY=
# Адрес Almaty Cleaner уже стоит в коде по умолчанию; строка оставлена
# в шаблоне для явности.
RIELTOR_CLEANER_URL=https://rieltor-cleaner-almaty.onrender.com

# --- OpenAI: Stage 2, разбор описаний объявлений ---
# Обязателен: без него оркестратор не стартует.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Обязательный отдельный ключ OpenAI для фотооценки. Код не делает fallback на
# OPENAI_API_KEY Stage 2, чтобы лимиты и расходы двух задач не смешивались.
RENOVATION_OPENAI_API_KEY=

# --- Online-фотооценка: очередь Mainrieltor и обмен с Cleaner ---
# Пока идёт локальная проверка, держать 0. При 1 каждая уже полученная
# из обычной ленты Collector карточка проходит через фотошлюз.
INTERIOR_ENABLED=0
# Отдельный секрет для GET /interior/evaluations и POST /interior/evaluations/ack.
INTERIOR_EXCHANGE_API_KEY=
# Локально можно 1–2; на Render значение подберём после замера RAM.
INTERIOR_CONCURRENCY=2
# После трёх неудач техническая error-строка снова станет в очередь через 6 часов.
INTERIOR_ERROR_RETRY_H=6
# Максимальное ожидание фотооценки перед обычным скорингом без неё.
# Карточка хранится в SQLite и не теряется при рестарте.
INTERIOR_DECISION_MAX_WAIT_SEC=1200
# Порт локально; Render сам передаст PORT.
INTERIOR_API_PORT=8080

# --- Telegram: доставка ---
# Если не задать обе переменные, отправка тихо выключается: журнал и
# реестр продолжают работать, ничего не падает.
# chat_id можно узнать через getUpdates у своего бота.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram user_id единственного администратора. Он управляет доступами,
# режимом рассылки и callback-кнопками через команды бота.
TELEGRAM_ADMIN_USER_ID=

# --- необязательные ---
# Куда складывать изменяемое состояние (реестр, курсор, журнал, baseline).
# Локально не задавайте — всё ляжет рядом со скриптом, как раньше.
# На Render = точка монтирования диска.
# KRISHA_DATA_DIR=/var/data

# На чистом диске обязательно beginning: фотооценка проверит всю
# доступную ленту. События старше COLLECTOR_MAX_EVENT_AGE_H не идут в Stage 2/Telegram,
# поэтому старая лента не вызовет текстовую LLM-оценку и рассылку.
# COLLECTOR_START_FROM=beginning
# COLLECTOR_POLL_INTERVAL_SEC=60
